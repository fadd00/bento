---
interface Props {
  title: string;
  description: string;
  emoji: string;
  tags: string[];
  github?: string;
  live?: string;
  size: 'large' | 'medium' | 'small';
  featured: boolean;
}

const { title, description, emoji, tags, github, live, size, featured } = Astro.props;

const spanClasses = {
  large: 'col-span-2 md:col-span-4 row-span-2',
  medium: 'col-span-2 md:col-span-2 row-span-1',
  small: 'col-span-1 md:col-span-1 row-span-1',
};
---

<div class={`card relative flex flex-col p-5 rounded-xl border transition-all duration-300 group ${spanClasses[size]} overflow-hidden`} style="background: rgba(0,0,0,0.4); border-color: rgba(82,82,91,0.2);">
  <div class="z-10 flex flex-col h-full justify-end">
    {size === 'large' && (
      <div class="flex-1 w-full flex items-center justify-center opacity-[0.06] mb-4">
        <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
             <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
               <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"/>
             </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)" />
        </svg>
      </div>
    )}

    <div class="flex flex-col gap-1.5 mt-auto">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-[rgba(255,255,255,0.05)] flex items-center justify-center text-xs overflow-hidden shrink-0 border border-[rgba(82,82,91,0.2)]">
          {emoji}
        </div>
        <h3 class="text-[15px] font-semibold text-white leading-tight truncate">{title}</h3>
      </div>

      {size !== 'small' && (
        <p class="text-sm text-cream line-clamp-2 mt-1 max-w-xl">{description}</p>
      )}
    </div>
  </div>

  {(github || live) && (
    <div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-20">
      {github && github !== '#' && (
        <a href={github} target="_blank" rel="noopener" class="bg-[rgba(0,0,0,0.4)] border border-[rgba(82,82,91,0.2)] rounded-full p-2 text-beige hover:text-white hover:border-[rgba(82,82,91,0.4)] transition-all" aria-label="GitHub Repository">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      )}
      {live && live !== '#' && (
        <a href={live} target="_blank" rel="noopener" class="bg-[rgba(0,0,0,0.4)] border border-[rgba(82,82,91,0.2)] rounded-full p-2 text-beige hover:text-white hover:border-[rgba(82,82,91,0.4)] transition-all" aria-label="Live Demo">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
    </div>
  )}
</div>
<style>
  .card:hover {
    border-color: rgba(82,82,91,0.4);
    box-shadow: 0px 20px 25px -5px rgba(0,0,0,0.15);
  }
</style>
