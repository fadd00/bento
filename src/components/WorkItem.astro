---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string;
  initials: string;
  accentColor: string;
  current?: boolean;
}

const { title, company, period, description, initials, accentColor, current } = Astro.props;
---

<div class="flex gap-4 p-5 rounded-xl border mt-4 card transition-colors duration-200" style="background: rgba(0,0,0,0.4); border-color: rgba(82,82,91,0.2);">
  <div
    class="w-12 h-12 rounded-full shrink-0 flex items-center justify-center text-white font-bold text-lg"
    style={`background-color: ${accentColor};`}
  >
    {initials}
  </div>
  <div class="flex-1">
    <div class="flex justify-between items-start flex-col sm:flex-row sm:items-center mb-1">
      <h3 class="text-lg font-semibold text-white">{title}</h3>
      <div class="flex items-center gap-2 mt-1 sm:mt-0">
        {current && (
           <span class="flex items-center gap-1.5 text-xs font-semibold text-electric bg-[rgba(79,70,229,0.15)] px-2 py-0.5 rounded-full border border-electric">
             <span class="w-1.5 h-1.5 rounded-full bg-electric animate-pulse"></span>
             Current
           </span>
        )}
        <span class="text-sm text-muted-text">{period}</span>
      </div>
    </div>
    <div class="text-sm text-beige mb-2 font-medium">{company}</div>
    <p class="text-sm text-cream leading-relaxed max-w-2xl">{description}</p>
  </div>
</div>
<style>
  .card:hover {
    border-color: rgba(82,82,91,0.4);
    box-shadow: 0px 20px 25px -5px rgba(0,0,0,0.15);
  }
</style>
