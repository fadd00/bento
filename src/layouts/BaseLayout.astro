---
interface Props {
  title: string;
  activeTab: string;
}

const { title, activeTab } = Astro.props;
import NavTabs from '../components/NavTabs.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Fadd</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet">
    <style is:global>
      .hero-bg {
        background: radial-gradient(ellipse at 20% 50%, rgba(15,23,42,0.9) 0%, transparent 60%),
                    radial-gradient(ellipse at 80% 30%, rgba(15,23,42,0.7) 0%, transparent 50%),
                    #07080F;
        position: relative;
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      main { animation: fadeUp 0.35s ease forwards; }
    </style>
  </head>
  <body class="bg-charcoal text-white min-h-screen pb-12">
    <header class="relative w-full h-48 sm:h-56 overflow-hidden">
      <div class="hero-bg absolute inset-0"></div>
    </header>

    <div class="max-w-4xl mx-auto px-4 relative">
      <div class="flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-6 -mt-10 sm:-mt-12 mb-6">
        <div class="avatar w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border-4 border-charcoal bg-electric z-10 shadow-xl">
          <img src="/avatar.png" alt="Fadd" class="w-full h-full object-cover" />
        </div>
        <div class="pb-1">
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-1">Fadd</h1>
          <p class="text-cream text-sm sm:text-base tracking-wide font-normal">
            Backend Developer &bull; IT Student
          </p>
        </div>
      </div>

      <NavTabs activeTab={activeTab} />
    </div>

    <main class="max-w-4xl mx-auto px-4 mt-8">
      <slot />
    </main>
  </body>
</html>
